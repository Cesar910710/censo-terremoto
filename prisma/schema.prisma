// Prisma schema — Censo post-terremoto
// Prioridad: Material / InventoryMovement (inventario de donaciones) primero,
// Family / Person / DamageAssessment (censo) después.
// Todas las tablas que se pueden crear en campo (offline) usan id String (uuid)
// generado por el cliente, para que la sincronización sea un simple insert,
// sin choques de ids entre dispositivos.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ENCUESTADOR
  INVENTARIO
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  createdAt    DateTime @default(now())

  inventoryMovements InventoryMovement[]
  familiesRegistered Family[]
}

// ---------- INVENTARIO (prioridad 1) ----------

enum MovementType {
  ENTRADA // donación recibida
  SALIDA // entrega a una familia
}

model Material {
  id        String   @id @default(uuid())
  name      String
  unit      String // ej: bulto, unidad, m2, saco
  category  String? // ej: techo, estructura, aseo, herramientas
  createdAt DateTime @default(now())

  movements        InventoryMovement[]
  neededByFamilies Family[]            @relation("FamilyMaterialsNeeded")

  @@unique([name, unit])
}

// Ledger de movimientos: el stock actual = suma de ENTRADA - suma de SALIDA.
// Esto hace que sincronizar offline sea seguro: cada registro es un insert
// independiente, nunca un update sobre una cantidad compartida.
model InventoryMovement {
  id              String       @id @default(uuid())
  material        Material     @relation(fields: [materialId], references: [id])
  materialId      String
  type            MovementType
  quantity        Float
  note            String?
  donorName       String? // solo aplica a ENTRADA
  recipientName   String? // solo aplica a SALIDA, si aún no existe censo de la familia
  family          Family?      @relation(fields: [familyId], references: [id])
  familyId        String? // solo aplica a SALIDA (a quién se le entregó, si ya está censada)
  createdBy       User?        @relation(fields: [createdByUserId], references: [id])
  createdByUserId String?
  occurredAt      DateTime     @default(now()) // momento real del movimiento (puede ser offline)
  createdAt       DateTime     @default(now()) // momento en que llegó al servidor
  // Id generado en el cliente, compartido por todos los materiales de una
  // misma entrega (Salida con varios materiales a la vez). Null en Entradas
  // y en Salidas de un solo material — no hay nada que agrupar en ese caso.
  deliveryId      String?

  @@index([materialId])
  @@index([familyId])
  @@index([deliveryId])
}

// ---------- CENSO (prioridad 2) ----------

enum DamageLevel {
  NINGUNO
  LEVE
  MODERADO
  SEVERO
  COLAPSO
}

enum ReviewStatus {
  PENDIENTE
  VERIFICADO
  ATENDIDO // ya recibió una entrega de materiales
  RECHAZADO
}

enum DocumentType {
  CC // Cédula de ciudadanía
  TI // Tarjeta de identidad
  CE // Cédula de extranjería
  PA // Pasaporte
  RC // Registro civil
  PEP // Permiso Especial de Permanencia
}

// Catálogo de municipios para poblar el picklist del censo — sembrado desde
// prisma/seed.ts. Family.municipality/department siguen siendo texto libre
// (no FK): no hace falta integridad referencial para un campo descriptivo.
model Municipio {
  id         String @id @default(uuid())
  name       String
  department String

  @@unique([name, department])
}

model Family {
  id                    String        @id @default(uuid())
  headOfHouseholdName   String
  documentType          DocumentType?
  documentNumber        String? // cédula/documento
  phone                 String?
  address               String?
  municipality          String?       @default("Versalles")
  department            String?       @default("Valle del Cauca")
  neighborhood          String? // barrio / vereda
  gpsLat                Float?
  gpsLng                Float?
  memberCount           Int           @default(1)
  hasResourcesToRebuild Boolean       @default(false)
  selfRegistered        Boolean       @default(false) // vino del formulario público
  reviewStatus          ReviewStatus  @default(PENDIENTE)
  registeredBy          User?         @relation(fields: [registeredByUserId], references: [id])
  registeredByUserId    String?
  occurredAt            DateTime      @default(now()) // momento real del registro (offline-safe)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  members          Person[]
  damageAssessment DamageAssessment?
  deliveries       InventoryMovement[]
  media            MediaAsset[]
  materialsNeeded  Material[]          @relation("FamilyMaterialsNeeded")

  @@index([reviewStatus])
}

model Person {
  id                 String    @id @default(uuid())
  family             Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  familyId           String
  fullName           String
  documentId         String?
  birthDate          DateTime?
  relationshipToHead String? // jefe de hogar, cónyuge, hijo/a, etc.
  vulnerabilities    String[] // ej: ["embarazada", "discapacidad", "adulto_mayor"]
  createdAt          DateTime  @default(now())

  @@index([familyId])
}

model DamageAssessment {
  id              String      @id @default(uuid())
  family          Family      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  familyId        String      @unique
  damageLevel     DamageLevel
  habitable       Boolean
  description     String?
  materialsNeeded String? // lista libre por ahora (v2: relacionar con Material)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

// Fotos de daños, recibos de donación, etc. — guardadas en R2, aquí solo la referencia.
model MediaAsset {
  id        String   @id @default(uuid())
  family    Family?  @relation(fields: [familyId], references: [id], onDelete: Cascade)
  familyId  String?
  r2Key     String
  url       String
  kind      String // "daño_vivienda", "documento", "entrega", etc.
  createdAt DateTime @default(now())

  @@index([familyId])
}
